<https://w3id.org/railsec-scope/case/etcs/scenario/protected-baseline/transmission-environment> a owl:Ontology ;
    owl:imports <https://w3id.org/railsec-scope/assessment>,
        <https://w3id.org/railsec-scope/railway> ;
    owl:versionIRI <https://w3id.org/railsec-scope/case/etcs/scenario/protected-baseline/transmission-environment/version/0.1.0> .

# Scenario: protected-baseline.
#
# L1 controls (monitoring/segmentation/rate-limiting) are set to true for
# every flow: these are genuine controls and can legitimately be varied for
# a hypothetical best case. crossesTrustBoundary and wirelessMedium are
# topology facts, not controls, and are carried over unchanged from the real
# architecture data (cases/etcs/transmission-environment.ttl) rather than
# invented, because fabricating topology would misrepresent the architecture
# rather than describe a hypothetical protection state over it.
#
# EN 50159 category conditions (environment controlled, participant set
# fixed, unauthorised access excluded) are asserted true for every flow,
# unlike the real data where only 52/88 interfaces had a supportable
# determination. This is the idealised counterfactual scenario: it is not
# claiming these are known for the real deployment.

case:scenario-protected-baseline-transmission-basis a rss-crit:JudgementBasis ;
    rss-crit:reasoning "L1 controls and EN 50159 environment conditions are set to their protective/determined values for every flow to construct a hypothetical best-achievable state for scenario comparison. Topology facts (crossesTrustBoundary, wirelessMedium) are not varied: they are carried over unchanged from the real architecture data because they describe the architecture, not a protection state that can be improved by policy."@en ;
    rss-crit:revisionConditions "Not applicable: this basis exists only to support scenario comparison and is never promoted to a case fact about the real ETCS deployment."@en .

case:flow-if-ct-01-forward rss-rail:crossesTrustBoundary true ;
    rss-rail:monitoringEnabled true ;
    rss-rail:networkSegmentationEnabled true ;
    rss-rail:rateLimitingEnabled true ;
    rss-rail:wirelessMedium false .

case:flow-if-ct-01-forward-protected-environment-control a rss-rail:EnvironmentControlFact ;
    prov:wasAttributedTo case:assessor ;
    prov:wasDerivedFrom case:scenario-protected-baseline-transmission-basis ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-rail:transmissionAssertionSubject case:flow-if-ct-01-forward ;
    rss-rail:environmentControlledValue true ;
    rss-res:assertedInInstanceSet case:instance-set .

case:flow-if-ct-01-forward-protected-participant-set a rss-rail:ParticipantSetFixedFact ;
    prov:wasAttributedTo case:assessor ;
    prov:wasDerivedFrom case:scenario-protected-baseline-transmission-basis ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-rail:transmissionAssertionSubject case:flow-if-ct-01-forward ;
    rss-rail:participantSetFixedValue true ;
    rss-res:assertedInInstanceSet case:instance-set .

