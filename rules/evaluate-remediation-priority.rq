PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rss-core: <https://w3id.org/railsec-scope/core#>
PREFIX rss-crit: <https://w3id.org/railsec-scope/criteria#>
PREFIX rss-rail: <https://w3id.org/railsec-scope/railway#>
PREFIX rss-res: <https://w3id.org/railsec-scope/results#>
PREFIX rss-rule: <https://w3id.org/railsec-scope/rules#>

# M5-R13 remediation priority (legacy v3 R2.4.3). A mobile-zone asset with a
# satisfied fail-safe compromise receives a high-priority remediation evaluation.

CONSTRUCT {
  ?evaluation a rss-res:CriterionEvaluation ;
      rss-res:evaluationConcernsElement ?asset ;
      rss-res:evaluatesCriterion ?criterion ;
      rss-res:hasEvaluationOutcome ?outcome ;
      rss-res:hasDerivationRecord ?record ;
      rss-res:producedByRun ?run .
  ?record a rss-res:DerivationRecord ;
      rss-res:hasStep ?step ;
      rss-res:completenessStatus ?completeness .
  ?step a rss-res:DerivationStep ;
      rss-res:stepPosition 1 ;
      rss-res:layerIdentifier "L2" ;
      rss-res:appliedCriterion ?criterion ;
      rss-res:executedByMechanism rss-rule:EvaluateRemediationPriority ;
      rss-res:usedEntity ?failSafeEvaluation ;
      prov:used ?asset ;
      rss-res:generatedResult ?evaluation .
}
WHERE {
  ?asset a rss-rail:SafetyCriticalAsset .
  ?run a rss-res:Run .
  ?criterion a rss-crit:Criterion ;
      rss-rail:assessesRemediationPriority ?priority ;
      rss-rail:assessesZoneClass ?zoneClass .

  ?failSafeEvaluation a rss-res:CriterionEvaluation ;
      rss-res:evaluationConcernsElement ?asset ;
      rss-res:evaluatesCriterion ?failSafeCriterion ;
      rss-res:hasEvaluationOutcome ?failSafeOutcome ;
      rss-res:producedByRun ?run .
  ?failSafeCriterion rss-rail:assessesFailSafeCompromiseFrom ?violation .

  BIND(EXISTS {
    ?asset rss-core:memberOf ?anyZone .
    ?anyZone a ?anyZoneClass .
    ?anyZoneClass rdfs:subClassOf* rss-rail:RailwaySecurityZone .
  } AS ?zoneInventoryStated)
  BIND(EXISTS {
    ?asset rss-core:memberOf ?matchedZone .
    ?matchedZone a ?matchedZoneClass .
    ?matchedZoneClass rdfs:subClassOf* ?zoneClass .
  } AS ?zoneClassMatched)
  BIND(IF(?failSafeOutcome = rss-res:undetermined || !?zoneInventoryStated, rss-res:undetermined,
          IF(?failSafeOutcome = rss-res:satisfied && ?zoneClassMatched, rss-res:satisfied, rss-res:notSatisfied)) AS ?outcome)
  BIND(IF(?outcome = rss-res:undetermined, "incomplete", "complete") AS ?completeness)
  BIND(IRI(CONCAT(STR(?asset), "/evaluation/remediation/", ENCODE_FOR_URI(STRAFTER(STR(?priority), "#")), "/run/", MD5(STR(?run)))) AS ?evaluation)
  BIND(IRI(CONCAT(STR(?evaluation), "/derivation")) AS ?record)
  BIND(IRI(CONCAT(STR(?evaluation), "/step/1")) AS ?step)
  FILTER(isIRI(?asset) && isIRI(?run) && isIRI(?criterion) && isIRI(?priority) && isIRI(?zoneClass))
}
