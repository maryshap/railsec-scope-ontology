PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rss-core: <https://w3id.org/railsec-scope/core#>
PREFIX rss-crit: <https://w3id.org/railsec-scope/criteria#>
PREFIX rss-rail: <https://w3id.org/railsec-scope/railway#>
PREFIX rss-res: <https://w3id.org/railsec-scope/results#>
PREFIX rss-rule: <https://w3id.org/railsec-scope/rules#>

CONSTRUCT {
  ?evaluation a rss-res:CriterionEvaluation ;
      rss-res:evaluationConcernsElement ?flow ;
      rss-res:evaluatesCriterion ?criterion ;
      rss-res:hasEvaluationOutcome ?outcome ;
      rss-res:hasDerivationRecord ?record ;
      rss-res:producedByRun ?run .
  ?record a rss-res:DerivationRecord ;
      rss-res:hasStep ?step ;
      rss-res:completenessStatus "complete" .
  ?step a rss-res:DerivationStep ;
      rss-res:stepPosition 1 ;
      rss-res:layerIdentifier "L2" ;
      rss-res:appliedCriterion ?criterion ;
      rss-res:executedByMechanism rss-rule:EvaluateTransmissionCategory ;
      rss-res:usedEntity ?control, ?fixedness, ?access ;
      rss-res:generatedResult ?evaluation .
}
WHERE {
  ?flow a rss-rail:RailwayInformationFlow .
  ?run a rss-res:Run ; rss-res:usedInstanceSet ?set .
  ?criterion a rss-crit:Criterion ; rss-crit:determinesMembershipOf ?category .
  VALUES ?category { rss-rail:Category1Transmission rss-rail:Category2Transmission rss-rail:Category3Transmission }

  OPTIONAL {
    ?control a rss-rail:EnvironmentControlFact ;
      rss-rail:transmissionAssertionSubject ?flow ;
      rss-rail:environmentControlledValue ?controlled ;
      rss-res:assertedInInstanceSet ?set .
  }
  OPTIONAL {
    ?fixedness a rss-rail:ParticipantSetFixedFact ;
      rss-rail:transmissionAssertionSubject ?flow ;
      rss-rail:participantSetFixedValue ?fixed ;
      rss-res:assertedInInstanceSet ?set .
  }
  OPTIONAL {
    ?access a rss-rail:UnauthorisedAccessExclusionAssumption ;
      rss-rail:transmissionAssertionSubject ?flow ;
      rss-rail:unauthorisedAccessExcludedValue ?accessExcluded ;
      rss-res:assertedInInstanceSet ?set .
  }

  BIND(BOUND(?controlled) && BOUND(?fixed) AS ?environmentKnown)
  BIND(?environmentKnown && ?controlled = true && ?fixed = true AS ?fullyControlled)
  BIND((BOUND(?controlled) && ?controlled = false) || (BOUND(?fixed) && ?fixed = false) AS ?notFullyControlled)
  BIND(
    IF(?category = rss-rail:Category1Transmission,
       IF(?fullyControlled, rss-res:satisfied, IF(?notFullyControlled, rss-res:notSatisfied, rss-res:undetermined)),
       IF(?fullyControlled, rss-res:notSatisfied,
          IF(!?notFullyControlled || !BOUND(?accessExcluded), rss-res:undetermined,
             IF(?category = rss-rail:Category2Transmission,
                IF(?accessExcluded = true, rss-res:satisfied, rss-res:notSatisfied),
                IF(?accessExcluded = false, rss-res:satisfied, rss-res:notSatisfied)))))
    AS ?outcome
  )
  BIND(IRI(CONCAT(STR(?flow), "/evaluation/", ENCODE_FOR_URI(STRAFTER(STR(?category), "#")))) AS ?evaluation)
  BIND(IRI(CONCAT(STR(?evaluation), "/derivation")) AS ?record)
  BIND(IRI(CONCAT(STR(?evaluation), "/step/1")) AS ?step)
  FILTER(isIRI(?flow) && isIRI(?run) && isIRI(?criterion))
}
