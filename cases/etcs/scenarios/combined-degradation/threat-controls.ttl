<https://w3id.org/railsec-scope/case/etcs/scenario/combined-degradation/threat-controls> a owl:Ontology ;
    owl:imports <https://w3id.org/railsec-scope/assessment>,
        <https://w3id.org/railsec-scope/railway> ;
    owl:versionIRI <https://w3id.org/railsec-scope/case/etcs/scenario/combined-degradation/threat-controls/version/0.1.0> .

case:scenario-combined-degradation-threat-control-basis a rss-crit:JudgementBasis ;
    rss-crit:reasoning "Two independent degradations: all corruption alternatives are false on flow-if-ts-06-forward, while sequence number and timestamp are false on flow-if-ts-03-forward."@en ;
    rss-crit:revisionConditions "Scenario assumption only; never promote to deployment evidence without an independent source."@en .

case:flow-if-ct-01-forward
    rss-rail:sequenceNumberEnabled true ;
    rss-rail:timestampEnabled true ;
    rss-rail:feedbackMessageEnabled true ;
    rss-rail:identificationProcedureEnabled true ;
    rss-rail:cryptographicMessageProtectionEnabled true .

case:flow-if-ct-01-forward-sequenceNumberEnabled-combined-degradation-assumption a rss-core:Assumption ;
    prov:wasAttributedTo case:assessor ;
    prov:wasDerivedFrom case:scenario-combined-degradation-threat-control-basis ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#sequenceNumberEnabled"^^xsd:anyURI ;
    rss-core:assertionSubject case:flow-if-ct-01-forward ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

