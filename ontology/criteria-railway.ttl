    rss-crit:evaluationStageIdentifier "control-weakness" ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI .

### Asset exposure, Category 3 context and entry-point criteria.

rsscr:asset-exposed-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:iec62443-3-2-6-location ;
    rss-crit:determinesMembershipOf rss-rail:ExposedAsset ;
    rss-crit:criterionStatement "An asset placed in an external railway security zone is exposed."@en ;
    rss-crit:evaluationStageIdentifier "asset-zone-classification" ;
    rss-crit:appliesInterpretation rsscr:zone-exposure-interpretation ;
    rss-crit:restsOnJudgement rsscr:zone-exposure-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayAsset"^^xsd:anyURI ;
    rss-rail:assessesZoneClass rss-rail:ExternalZone .

rsscr:asset-partially-exposed-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:iec62443-3-2-6-location ;
    rss-crit:determinesMembershipOf rss-rail:PartiallyExposedAsset ;
    rss-crit:criterionStatement "An asset placed in a partially trusted railway security zone is partially exposed."@en ;
    rss-crit:evaluationStageIdentifier "asset-zone-classification" ;
    rss-crit:appliesInterpretation rsscr:zone-exposure-interpretation ;
    rss-crit:restsOnJudgement rsscr:zone-exposure-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayAsset"^^xsd:anyURI ;
    rss-rail:assessesZoneClass rss-rail:PartiallyTrustedZone .

rsscr:category-3-asset-context-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-6-3-location ;
    rss-crit:determinesMembershipOf rss-rail:Category3AssetContext ;
    rss-crit:criterionStatement "An asset placed in an external railway security zone operates in a Category 3 asset context."@en ;
    rss-crit:evaluationStageIdentifier "asset-zone-classification" ;
    rss-crit:appliesInterpretation rsscr:zone-exposure-interpretation ;
    rss-crit:restsOnJudgement rsscr:zone-exposure-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayAsset"^^xsd:anyURI ;
    rss-rail:assessesZoneClass rss-rail:ExternalZone .

rsscr:entry-external-zone-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:iec62443-3-2-6-location ;
    rss-crit:determinesMembershipOf rss-crit:EntryPoint ;
    rss-crit:criterionStatement "An asset placed in an external railway security zone is an entry point candidate."@en ;
    rss-crit:evaluationStageIdentifier "asset-zone-classification" ;
    rss-crit:appliesInterpretation rsscr:entry-point-interpretation ;
    rss-crit:restsOnJudgement rsscr:zone-exposure-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayAsset"^^xsd:anyURI ;
    rss-rail:assessesZoneClass rss-rail:ExternalZone .

rsscr:entry-dmz-zone-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:iec62443-3-2-6-location ;
    rss-crit:determinesMembershipOf rss-crit:EntryPoint ;
    rss-crit:criterionStatement "An asset placed in a DMZ railway security zone is an entry point candidate."@en ;
    rss-crit:evaluationStageIdentifier "asset-zone-classification" ;
    rss-crit:appliesInterpretation rsscr:entry-point-interpretation ;
    rss-crit:restsOnJudgement rsscr:zone-exposure-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayAsset"^^xsd:anyURI ;
    rss-rail:assessesZoneClass rss-rail:DMZZone .

rsscr:mobile-zone-remediation-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:ts50701-location, rsscr:en50126-4-location ;
    rss-crit:criterionStatement "A safety-critical asset with a satisfied fail-safe compromise in a mobile railway zone requires high-priority remediation."@en ;
    rss-crit:evaluationStageIdentifier "remediation-priority" ;
    rss-crit:appliesInterpretation rsscr:remediation-priority-interpretation ;
    rss-crit:restsOnJudgement rsscr:failsafe-fail-safe-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#SafetyCriticalAsset"^^xsd:anyURI ;
    rss-rail:assessesZoneClass rss-rail:MobileZone ;
    rss-rail:assessesRemediationPriority rss-rail:highPriorityRemediation .

