@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fx: <https://w3id.org/railsec-scope/fixture/governance/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rss-core: <https://w3id.org/railsec-scope/core#> .
@prefix rss-crit: <https://w3id.org/railsec-scope/criteria#> .
@prefix rss-gov: <https://w3id.org/railsec-scope/governance#> .
@prefix rss-res: <https://w3id.org/railsec-scope/results#> .

fx:version a rss-crit:ArtefactVersion ;
    rss-crit:versionIdentifier "governance-fixture-1" .

fx:instance-set a rss-res:InstanceSet ;
    rss-crit:hasVersion fx:version ;
    dcterms:source "Purpose-built governance fixture; not railway evidence."@en .

fx:assessment a rss-gov:AssessmentContext .
fx:asset a rss-core:Asset, rss-core:Element .

fx:infrastructure-manager a rss-gov:InfrastructureManager .
fx:maintenance-provider a rss-gov:MaintenanceServiceProvider .

fx:asset-register a prov:Entity .
fx:maintenance-plan a prov:Entity .

fx:operational-control a rss-gov:StakeholderResponsibilityAssignment ;
    rss-gov:responsibilityAssignmentSubject fx:asset ;
    rss-gov:responsibilityHolder fx:infrastructure-manager ;
    rss-gov:hasResponsibilityKind rss-gov:operationalControl ;
    rss-core:hasEpistemicStatus rss-core:assertedFactStatus ;
    rss-res:assertedInInstanceSet fx:instance-set ;
    prov:wasDerivedFrom fx:asset-register .

fx:maintenance-responsibility a rss-gov:StakeholderResponsibilityAssignment ;
    rss-gov:responsibilityAssignmentSubject fx:asset ;
    rss-gov:responsibilityHolder fx:maintenance-provider ;
    rss-gov:hasResponsibilityKind rss-gov:assetMaintenance ;
    rss-core:hasEpistemicStatus rss-core:assertedFactStatus ;
    rss-res:assertedInInstanceSet fx:instance-set ;
    prov:wasDerivedFrom fx:maintenance-plan .

fx:granted a rss-core:AuthorisationStatus .

fx:authorisation a rss-gov:AssessmentAuthorisationAssertion ;
    rss-core:authorisationSubject fx:asset ;
    rss-core:authorisationValue fx:granted ;
    rss-gov:authorisesAssessment fx:assessment ;
    rss-gov:authorisationIssuedBy fx:infrastructure-manager ;
    rss-gov:authorisationSupportedBy fx:operational-control ;
    rss-gov:requiresAcknowledgementFrom fx:maintenance-provider ;
    rss-core:hasEpistemicStatus rss-core:assertedFactStatus ;
    rss-res:assertedInInstanceSet fx:instance-set .

fx:maintenance-window a rss-gov:MaintenanceWindowConstraint ;
    rss-core:appliesToElement fx:asset ;
    rss-gov:constraintAppliesToAssessment fx:assessment ;
    rss-gov:constraintSpecifiedBy fx:maintenance-provider ;
    rss-gov:constraintEvidence fx:maintenance-plan ;
    rss-gov:requiresCoordinationWith fx:maintenance-provider .
