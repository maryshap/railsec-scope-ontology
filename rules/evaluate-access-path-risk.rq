PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rss-core: <https://w3id.org/railsec-scope/core#>
PREFIX rss-crit: <https://w3id.org/railsec-scope/criteria#>
PREFIX rss-rail: <https://w3id.org/railsec-scope/railway#>
PREFIX rss-res: <https://w3id.org/railsec-scope/results#>
PREFIX rss-rule: <https://w3id.org/railsec-scope/rules#>
PREFIX rsscr: <https://w3id.org/railsec-scope/criteria/railway/>

# M5-R08 access path risk on an information flow (legacy v3 R2.6.2, R2.6.4).
#
# highRiskMaintenancePath: a flow terminating at a safety-critical asset whose
#   origin is reachable by the assessed access mechanism. An unstated origin or
#   an unstated access inventory on the origin is undetermined.
# remoteAccessRisk: a flow reachable by the assessed access mechanism that also
#   carries a satisfied transmission-threat evaluation. An undetermined threat
#   propagates.

CONSTRUCT {
  ?evaluation a rss-res:CriterionEvaluation ;
      rss-res:evaluationConcernsElement ?flow ;
      rss-res:evaluatesCriterion ?criterion ;
      rss-res:hasEvaluationOutcome ?outcome ;
      rss-res:hasDerivationRecord ?record ;
      rss-res:producedByRun ?run .
  ?record a rss-res:DerivationRecord ;
      rss-res:hasStep ?step ;
      rss-res:completenessStatus ?completeness .
  ?step a rss-res:DerivationStep ;
      rss-res:stepPosition 1 ;
      rss-res:layerIdentifier "L2" ;
      rss-res:appliedCriterion ?criterion ;
      rss-res:executedByMechanism rss-rule:EvaluateAccessPathRisk ;
      prov:used ?flow ;
      rss-res:generatedResult ?evaluation .
}
WHERE {
  {
    SELECT ?flow ?run ?risk ?criterion
           (MAX(IF(BOUND(?safetyAsset), 1, 0)) AS ?terminatesAtSafetyCriticalCount)
           (MAX(IF(BOUND(?anyOrigin), 1, 0)) AS ?originStatedCount)
           (MAX(IF(BOUND(?anyOriginMechanism), 1, 0)) AS ?originInventoryStatedCount)
           (MAX(IF(BOUND(?originMechanism), 1, 0)) AS ?originMechanismPresentCount)
           (MAX(IF(BOUND(?anyFlowMechanism), 1, 0)) AS ?flowInventoryStatedCount)
           (MAX(IF(BOUND(?flowMechanism), 1, 0)) AS ?flowMechanismPresentCount)
           (COUNT(?threatOutcome) AS ?threatEvalCount)
           (SUM(IF(?threatOutcome = rss-res:satisfied, 1, 0)) AS ?threatSatisfiedCount)
           (SUM(IF(?threatOutcome = rss-res:undetermined, 1, 0)) AS ?threatUndeterminedCount)
    WHERE {
      ?flow a rss-rail:RailwayInformationFlow .
      ?run a rss-res:Run .
      VALUES (?risk ?criterion ?mechanismClass) {
        (rss-rail:highRiskMaintenancePath rsscr:access-maintenance-path-criterion rss-rail:MaintenanceAccess)
        (rss-rail:remoteAccessRisk rsscr:access-remote-access-criterion rss-rail:RemoteAccess)
      }
      ?criterion a rss-crit:Criterion ;
          rss-rail:assessesAccessRisk ?risk ;
          rss-rail:assessesAccessMechanism ?mechanismClass .

      OPTIONAL { ?flow rss-core:hasDestination ?safetyAsset . ?safetyAsset a rss-rail:SafetyCriticalAsset . }
      OPTIONAL { ?flow rss-core:hasOrigin ?anyOrigin . }
      OPTIONAL { ?flow rss-core:hasOrigin ?statedOrigin . ?statedOrigin rss-core:reachableBy ?anyOriginMechanism . }
      OPTIONAL { ?flow rss-core:hasOrigin ?matchedOrigin . ?matchedOrigin rss-core:reachableBy ?originMechanism . ?originMechanism rdf:type ?mechanismClass . }
      OPTIONAL { ?flow rss-core:reachableBy ?anyFlowMechanism . }
      OPTIONAL { ?flow rss-core:reachableBy ?flowMechanism . ?flowMechanism rdf:type ?mechanismClass . }

      VALUES ?threat {
        rss-rail:RepetitionThreat rss-rail:DeletionThreat rss-rail:InsertionThreat
        rss-rail:ResequencingThreat rss-rail:CorruptionThreat rss-rail:DelayThreat
        rss-rail:MasqueradeThreat
      }
      BIND(IRI(CONCAT(STR(?flow), "/evaluation/threat/", ENCODE_FOR_URI(STRAFTER(STR(?threat), "#")), "/run/", MD5(STR(?run)))) AS ?threatEvaluation)
      OPTIONAL {
        ?threatEvaluation rss-res:evaluationConcernsElement ?flow ;
            rss-res:hasEvaluationOutcome ?threatOutcome ;
            rss-res:producedByRun ?run .
      }
    }
    GROUP BY ?flow ?run ?risk ?criterion
  }

  BIND(?terminatesAtSafetyCriticalCount > 0 AS ?terminatesAtSafetyCritical)
  BIND(?originStatedCount > 0 AS ?originStated)
  BIND(?originInventoryStatedCount > 0 AS ?originInventoryStated)
  BIND(?originMechanismPresentCount > 0 AS ?originMechanismPresent)
  BIND(?flowInventoryStatedCount > 0 AS ?flowInventoryStated)
  BIND(?flowMechanismPresentCount > 0 AS ?flowMechanismPresent)
  BIND(?threatEvalCount > 0 AS ?threatStageRan)
  BIND(?threatSatisfiedCount > 0 AS ?anyThreatSatisfied)
  BIND(?threatUndeterminedCount > 0 AS ?anyThreatUndetermined)

  BIND(
    IF(?risk = rss-rail:highRiskMaintenancePath,
       IF(!?originStated || !?originInventoryStated, rss-res:undetermined,
          IF(?terminatesAtSafetyCritical && ?originMechanismPresent, rss-res:satisfied, rss-res:notSatisfied)),
       IF(!?flowInventoryStated || !?threatStageRan, rss-res:undetermined,
          IF(!?flowMechanismPresent, rss-res:notSatisfied,
             IF(?anyThreatSatisfied, rss-res:satisfied,
                IF(?anyThreatUndetermined, rss-res:undetermined, rss-res:notSatisfied)))))
    AS ?outcome
  )
  BIND(IF(?outcome = rss-res:undetermined, "incomplete", "complete") AS ?completeness)
  BIND(IRI(CONCAT(STR(?flow), "/evaluation/access/", ENCODE_FOR_URI(STRAFTER(STR(?risk), "#")), "/run/", MD5(STR(?run)))) AS ?evaluation)
  BIND(IRI(CONCAT(STR(?evaluation), "/derivation")) AS ?record)
  BIND(IRI(CONCAT(STR(?evaluation), "/step/1")) AS ?step)
  FILTER(isIRI(?flow) && isIRI(?run) && isIRI(?criterion) && isIRI(?risk))
}
