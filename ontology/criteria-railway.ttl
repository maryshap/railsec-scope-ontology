    rss-crit:appliesInterpretation rsscr:l1-control-interpretation ;
    rss-crit:criterionStatement "A flow crossing a trust boundary without encryption is confidentiality-vulnerable."@en ;
    rss-crit:evaluationStageIdentifier "control-weakness" ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI .

### Asset exposure, Category 3 context and entry-point criteria.

rsscr:asset-exposed-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:ts50701-6-5-3-location ;
    rss-crit:determinesMembershipOf rss-rail:ExposedAsset ;
    rss-crit:criterionStatement "Under the assessor's zone taxonomy informed by prTS 50701 D8E4:2020, an asset placed in an external railway security zone is exposed."@en ;
    rss-crit:evaluationStageIdentifier "asset-zone-classification" ;
    rss-crit:appliesInterpretation rsscr:zone-exposure-interpretation ;
    rss-crit:restsOnJudgement rsscr:zone-exposure-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayAsset"^^xsd:anyURI ;
    rss-rail:assessesZoneClass rss-rail:ExternalZone .

rsscr:asset-partially-exposed-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:ts50701-6-5-3-location ;
    rss-crit:determinesMembershipOf rss-rail:PartiallyExposedAsset ;
    rss-crit:criterionStatement "Under the assessor's zone taxonomy informed by prTS 50701 D8E4:2020, an asset placed in a partially trusted railway security zone is partially exposed."@en ;
    rss-crit:evaluationStageIdentifier "asset-zone-classification" ;
    rss-crit:appliesInterpretation rsscr:zone-exposure-interpretation ;
    rss-crit:restsOnJudgement rsscr:zone-exposure-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayAsset"^^xsd:anyURI ;
    rss-rail:assessesZoneClass rss-rail:PartiallyTrustedZone .

rsscr:category-3-asset-context-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-6-3-3-location ;
    rss-crit:determinesMembershipOf rss-rail:Category3AssetContext ;
    rss-crit:criterionStatement "Under the assessor's architecture projection, an asset placed in an external railway security zone is flagged as a Category 3 asset context; EN 50159:2010 categorises transmission systems, not assets."@en ;
    rss-crit:evaluationStageIdentifier "asset-zone-classification" ;
    rss-crit:appliesInterpretation rsscr:zone-exposure-interpretation ;
    rss-crit:restsOnJudgement rsscr:zone-exposure-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayAsset"^^xsd:anyURI ;
    rss-rail:assessesZoneClass rss-rail:ExternalZone .

rsscr:entry-external-zone-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:ts50701-6-5-3-location ;
    rss-crit:determinesMembershipOf rss-crit:EntryPoint ;
    rss-crit:criterionStatement "Under the assessor's attack-surface policy informed by prTS 50701 D8E4:2020, an asset placed in an external railway security zone is an entry-point candidate."@en ;
    rss-crit:evaluationStageIdentifier "asset-zone-classification" ;
    rss-crit:appliesInterpretation rsscr:entry-point-interpretation ;
    rss-crit:restsOnJudgement rsscr:zone-exposure-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayAsset"^^xsd:anyURI ;
    rss-rail:assessesZoneClass rss-rail:ExternalZone .

rsscr:entry-dmz-zone-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:ts50701-3-1-32-location, rsscr:ts50701-6-5-3-location ;
    rss-crit:determinesMembershipOf rss-crit:EntryPoint ;
    rss-crit:criterionStatement "Under the assessor's attack-surface policy informed by prTS 50701 D8E4:2020, an asset placed in a DMZ railway security zone is an entry-point candidate."@en ;
    rss-crit:evaluationStageIdentifier "asset-zone-classification" ;
    rss-crit:appliesInterpretation rsscr:entry-point-interpretation ;
    rss-crit:restsOnJudgement rsscr:zone-exposure-basis ;
