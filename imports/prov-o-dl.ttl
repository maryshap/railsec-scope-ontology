@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.w3.org/ns/prov-o> a owl:Ontology ;
    owl:versionIRI <http://www.w3.org/ns/prov-o-20130430> ;
    rdfs:comment "OWL 2 DL-safe dependency projection of the W3C PROV-O terms used by RailSec Scope Ontology. The unmodified canonical source is pinned beside this file."@en .

prov:Entity a owl:Class .
prov:Activity a owl:Class ; owl:disjointWith prov:Entity .
prov:Agent a owl:Class .
prov:SoftwareAgent a owl:Class ; rdfs:subClassOf prov:Agent .
prov:Plan a owl:Class ; rdfs:subClassOf prov:Entity .
prov:Bundle a owl:Class ; rdfs:subClassOf prov:Entity .

prov:used a owl:ObjectProperty ; rdfs:domain prov:Activity ; rdfs:range prov:Entity .
prov:generated a owl:ObjectProperty ; rdfs:domain prov:Activity ; rdfs:range prov:Entity .
prov:wasGeneratedBy a owl:ObjectProperty ; owl:inverseOf prov:generated ; rdfs:domain prov:Entity ; rdfs:range prov:Activity .
prov:wasAssociatedWith a owl:ObjectProperty ; rdfs:domain prov:Activity ; rdfs:range prov:Agent .
prov:wasAttributedTo a owl:ObjectProperty ; rdfs:domain prov:Entity ; rdfs:range prov:Agent .
prov:wasDerivedFrom a owl:ObjectProperty ; rdfs:domain prov:Entity ; rdfs:range prov:Entity .
