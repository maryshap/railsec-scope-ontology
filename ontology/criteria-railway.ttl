# Railway assessment criteria (M5).
#
# Criteria state the conditions under which a category applies; rules apply
# them. They belong to a module rather than to case data or to fixtures, so
# that any case loading the ontology is assessed under the same criteria.
# Text and provenance are unchanged from where they were first written; only
# the identifiers moved.
#
# Every criterion here rests on a recorded judgement basis. Replacing those
# with reviewed source locations and interpretations is outstanding.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rss-crit: <https://w3id.org/railsec-scope/criteria#> .
@prefix rss-rail: <https://w3id.org/railsec-scope/railway#> .
@prefix rsscr: <https://w3id.org/railsec-scope/criteria/railway/> .
@prefix rsso: <https://w3id.org/railsec-scope/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/railsec-scope/criteria/railway> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/railsec-scope/version/0.1.0/criteria/railway> ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://w3id.org/railsec-scope/railway> ;
    rsso:moduleCode "M5" ;
    rsso:termNamespace "https://w3id.org/railsec-scope/criteria/railway/"^^xsd:anyURI ;
    dcterms:title "RailSec Scope Ontology — M5 railway assessment criteria"@en ;
    dcterms:description "Reusable railway assessment criteria and their recorded judgement bases."@en .

rsscr:criteria-module-version a rss-crit:ArtefactVersion ;
    rss-crit:versionIdentifier "0.1.0-phase2" .

rsscr:access-maintenance-access-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:ts50701-6-5-2-location ;
    rss-crit:criterionStatement "Under the assessor's access-risk policy informed by prTS 50701 D8E4:2020, a safety-critical asset reachable by maintenance access carries a privileged access risk."@en ;
    rss-crit:evaluationStageIdentifier "access-risk" ;
    rss-crit:appliesInterpretation rsscr:access-risk-interpretation ;
    rss-crit:restsOnJudgement rsscr:access-access-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#SafetyCriticalAsset"^^xsd:anyURI ;
    rss-rail:assessesAccessMechanism rss-rail:MaintenanceAccess ;
    rss-rail:assessesAccessRisk rss-rail:privilegedMaintenanceAccessRisk .

rsscr:access-maintenance-path-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:ts50701-6-5-2-location ;
    rss-crit:criterionStatement "Under the assessor's access-risk policy informed by prTS 50701 D8E4:2020, a flow terminating at a safety-critical asset whose origin is reachable by maintenance access is a high-risk maintenance path."@en ;
    rss-crit:evaluationStageIdentifier "access-path" ;
    rss-crit:appliesInterpretation rsscr:access-risk-interpretation ;
    rss-crit:restsOnJudgement rsscr:access-access-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesAccessMechanism rss-rail:MaintenanceAccess ;
    rss-rail:assessesAccessRisk rss-rail:highRiskMaintenancePath .

rsscr:access-remote-access-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:ts50701-3-1-59-location ;
    rss-crit:criterionStatement "Under the assessor's access-risk policy informed by prTS 50701 D8E4:2020, a flow reachable by remote access that carries a satisfied transmission-threat evaluation is a remote access risk."@en ;
    rss-crit:evaluationStageIdentifier "access-path" ;
    rss-crit:appliesInterpretation rsscr:access-risk-interpretation ;
    rss-crit:restsOnJudgement rsscr:access-access-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesAccessMechanism rss-rail:RemoteAccess ;
    rss-rail:assessesAccessRisk rss-rail:remoteAccessRisk .

rsscr:access-supplier-access-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:ts50701-6-5-2-location ;
    rss-crit:criterionStatement "Under the assessor's access-risk policy informed by prTS 50701 D8E4:2020, a safety-critical asset reachable by supplier access carries a privileged supply-chain risk."@en ;
    rss-crit:evaluationStageIdentifier "access-risk" ;
    rss-crit:appliesInterpretation rsscr:access-risk-interpretation ;
    rss-crit:restsOnJudgement rsscr:access-access-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#SafetyCriticalAsset"^^xsd:anyURI ;
    rss-rail:assessesAccessMechanism rss-rail:SupplierAccess ;
    rss-rail:assessesAccessRisk rss-rail:privilegedSupplierAccessRisk .

rsscr:category-category-1-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-6-3-1-location ;
    rss-crit:determinesMembershipOf rss-rail:Category1Transmission ;
    rss-crit:criterionStatement "A transmission is Category 1 only when Pr1, Pr2 and Pr3 of EN 50159:2010 are all satisfied."@en ;
    rss-crit:evaluationStageIdentifier "transmission-category" ;
    rss-crit:appliesInterpretation rsscr:category-interpretation ;
    rss-crit:restsOnJudgement rsscr:category-category-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI .

rsscr:category-category-2-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-6-3-2-location ;
    rss-crit:determinesMembershipOf rss-rail:Category2Transmission ;
    rss-crit:criterionStatement "A transmission is Category 2 when Pr1 or Pr2 is not satisfied and Pr3 is satisfied, as specified by EN 50159:2010."@en ;
    rss-crit:evaluationStageIdentifier "transmission-category" ;
    rss-crit:appliesInterpretation rsscr:category-interpretation ;
    rss-crit:restsOnJudgement rsscr:category-category-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI .

rsscr:category-category-3-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-6-3-3-location ;
    rss-crit:determinesMembershipOf rss-rail:Category3Transmission ;
    rss-crit:criterionStatement "A transmission is Category 3 whenever Pr3 is not satisfied, independently of Pr1 and Pr2, as specified by EN 50159:2010."@en ;
    rss-crit:evaluationStageIdentifier "transmission-category" ;
    rss-crit:appliesInterpretation rsscr:category-interpretation ;
    rss-crit:restsOnJudgement rsscr:category-category-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI .

rsscr:critical-authenticity-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-7-1-location ;
    rss-crit:criterionStatement "Under the recorded assessor prioritisation policy, a masquerade-exposed flow carrying a safety-related payload is a critical authenticity violation."@en ;
    rss-crit:evaluationStageIdentifier "critical-violation" ;
    rss-crit:appliesInterpretation rsscr:critical-violation-interpretation ;
    rss-crit:restsOnJudgement rsscr:critical-critical-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesCriticalViolation rss-rail:criticalAuthenticityViolation ;
    rss-rail:elevatesTransmissionThreat rss-rail:MasqueradeThreat .

rsscr:critical-integrity-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-7-1-location ;
    rss-crit:criterionStatement "Under the recorded assessor prioritisation policy, a corruption-exposed flow carrying a safety-related payload is a critical integrity violation."@en ;
    rss-crit:evaluationStageIdentifier "critical-violation" ;
    rss-crit:appliesInterpretation rsscr:critical-violation-interpretation ;
    rss-crit:restsOnJudgement rsscr:critical-critical-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesCriticalViolation rss-rail:criticalIntegrityViolation ;
    rss-rail:elevatesTransmissionThreat rss-rail:CorruptionThreat .

rsscr:critical-timeliness-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-7-1-location ;
    rss-crit:criterionStatement "Under the recorded assessor prioritisation policy, a delay-exposed flow carrying assessor-classified emergency command data is a critical timeliness violation."@en ;
    rss-crit:evaluationStageIdentifier "critical-violation" ;
    rss-crit:appliesInterpretation rsscr:critical-violation-interpretation ;
    rss-crit:restsOnJudgement rsscr:critical-critical-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesCriticalViolation rss-rail:criticalTimelinessViolation ;
    rss-rail:elevatesTransmissionThreat rss-rail:DelayThreat ;
    rss-rail:requiresPayloadClass rss-rail:EmergencyCommandData .

rsscr:critical-sequence-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-7-1-location ;
    rss-crit:criterionStatement "Under the recorded assessor prioritisation policy, a resequencing-exposed flow carrying assessor-classified position/status data is a critical sequence violation."@en ;
    rss-crit:evaluationStageIdentifier "critical-violation" ;
    rss-crit:appliesInterpretation rsscr:critical-violation-interpretation ;
    rss-crit:restsOnJudgement rsscr:critical-critical-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesCriticalViolation rss-rail:criticalSequenceViolation ;
    rss-rail:elevatesTransmissionThreat rss-rail:ResequencingThreat ;
    rss-rail:requiresPayloadClass rss-rail:PositionStatusData .

rsscr:failsafe-authenticity-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50126-1-3-68-location, rsscr:en50159-3-1-52-location, rsscr:ts50701-5-5-4-location ;
    rss-crit:criterionStatement "A safety-critical asset has an authenticity-driven fail-safe compromise when its fail-safe function depends on that asset and an incoming flow has a satisfied critical-authenticity evaluation."@en ;
    rss-crit:evaluationStageIdentifier "fail-safe-compromise" ;
    rss-crit:appliesInterpretation rsscr:failsafe-interpretation ;
    rss-crit:restsOnJudgement rsscr:failsafe-fail-safe-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#SafetyCriticalAsset"^^xsd:anyURI ;
    rss-rail:assessesFailSafeCompromiseFrom rss-rail:criticalAuthenticityViolation .

rsscr:failsafe-integrity-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50126-1-3-68-location, rsscr:en50159-3-1-52-location, rsscr:ts50701-5-5-4-location ;
    rss-crit:criterionStatement "A safety-critical asset has an integrity-driven fail-safe compromise when its fail-safe function depends on that asset and an incoming flow has a satisfied critical-integrity evaluation."@en ;
    rss-crit:evaluationStageIdentifier "fail-safe-compromise" ;
    rss-crit:appliesInterpretation rsscr:failsafe-interpretation ;
    rss-crit:restsOnJudgement rsscr:failsafe-fail-safe-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#SafetyCriticalAsset"^^xsd:anyURI ;
    rss-rail:assessesFailSafeCompromiseFrom rss-rail:criticalIntegrityViolation .

rsscr:sil-maximum-risk-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50126-1-3-70-location, rsscr:en50126-2-10-2-8-location ;
    rss-crit:criterionStatement "Under the recorded assessor scoping policy, a safety-critical asset whose fail-safe compromise evaluation is satisfied carries the maximum safety-integrity concern; this result does not allocate a SIL."@en ;
    rss-crit:evaluationStageIdentifier "sil-risk" ;
    rss-crit:appliesInterpretation rsscr:sil-risk-interpretation ;
    rss-crit:restsOnJudgement rsscr:sil-sil-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#SafetyCriticalAsset"^^xsd:anyURI ;
    rss-rail:assessesSILRisk rss-rail:maximumSILRisk .

rsscr:threat-corruption-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-5-location, rsscr:en50159-7-4-2-location ;
    rss-crit:criterionStatement "A transmission is corruption-exposed only when every EN 50159:2010 Table 1 alternative (safety code and cryptographic technique) is explicitly absent."@en ;
    rss-crit:evaluationStageIdentifier "transmission-threat" ;
    rss-crit:appliesInterpretation rsscr:threat-interpretation ;
    rss-crit:restsOnJudgement rsscr:threat-threat-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesTransmissionThreat rss-rail:CorruptionThreat .

rsscr:threat-delay-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-5-location, rsscr:en50159-7-4-2-location ;
    rss-crit:criterionStatement "A transmission is delay-exposed only when every EN 50159:2010 Table 1 alternative (time stamp and time-out) is explicitly absent."@en ;
    rss-crit:evaluationStageIdentifier "transmission-threat" ;
    rss-crit:appliesInterpretation rsscr:threat-interpretation ;
    rss-crit:restsOnJudgement rsscr:threat-threat-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesTransmissionThreat rss-rail:DelayThreat .

rsscr:threat-deletion-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-5-location, rsscr:en50159-7-4-2-location ;
    rss-crit:criterionStatement "A transmission is deletion-exposed when the EN 50159:2010 Table 1 defence, a sequence number, is explicitly absent."@en ;
    rss-crit:evaluationStageIdentifier "transmission-threat" ;
    rss-crit:appliesInterpretation rsscr:threat-interpretation ;
    rss-crit:restsOnJudgement rsscr:threat-threat-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesTransmissionThreat rss-rail:DeletionThreat .

rsscr:threat-insertion-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-5-location, rsscr:en50159-7-4-2-location ;
    rss-crit:criterionStatement "A transmission is insertion-exposed only when every EN 50159:2010 Table 1 alternative (sequence number, source identifier, feedback message and identification procedure) is explicitly absent."@en ;
    rss-crit:evaluationStageIdentifier "transmission-threat" ;
    rss-crit:appliesInterpretation rsscr:threat-interpretation ;
    rss-crit:restsOnJudgement rsscr:threat-threat-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesTransmissionThreat rss-rail:InsertionThreat .

rsscr:threat-masquerade-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-5-location, rsscr:en50159-6-4-location, rsscr:en50159-7-4-2-location ;
    rss-crit:criterionStatement "An open Category 2 or 3 transmission is masquerade-exposed only when every EN 50159:2010 Table 1 alternative (feedback message, identification procedure and cryptographic technique) is explicitly absent."@en ;
    rss-crit:evaluationStageIdentifier "transmission-threat" ;
    rss-crit:appliesInterpretation rsscr:threat-interpretation ;
    rss-crit:restsOnJudgement rsscr:threat-threat-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesTransmissionThreat rss-rail:MasqueradeThreat .

rsscr:threat-repetition-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-5-location, rsscr:en50159-7-4-2-location ;
    rss-crit:criterionStatement "A transmission is repetition-exposed only when every EN 50159:2010 Table 1 alternative (sequence number and time stamp) is explicitly absent."@en ;
    rss-crit:evaluationStageIdentifier "transmission-threat" ;
    rss-crit:appliesInterpretation rsscr:threat-interpretation ;
    rss-crit:restsOnJudgement rsscr:threat-threat-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesTransmissionThreat rss-rail:RepetitionThreat .

rsscr:threat-resequencing-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:en50159-5-location, rsscr:en50159-7-4-2-location ;
    rss-crit:criterionStatement "A transmission is resequencing-exposed only when every EN 50159:2010 Table 1 alternative (sequence number and time stamp) is explicitly absent."@en ;
    rss-crit:evaluationStageIdentifier "transmission-threat" ;
    rss-crit:appliesInterpretation rsscr:threat-interpretation ;
    rss-crit:restsOnJudgement rsscr:threat-threat-basis ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-rail:assessesTransmissionThreat rss-rail:ResequencingThreat .

rsscr:sil-sil-basis a rss-crit:JudgementBasis ;
    rss-crit:reasoning "Assessor scoping policy retained from legacy R2.5.3: a safety-critical asset with a satisfied fail-safe compromise is assigned the highest safety-integrity concern for penetration-test prioritisation. EN 50126-1:2017 and EN 50126-2:2017 do not make this a SIL allocation."@en ;
    rss-crit:revisionConditions "Revise if the assessor changes the prioritisation policy. A real SIL value must be recorded separately against a safety-related electronic function and reviewed when safety-case evidence becomes available."@en .

rsscr:critical-critical-basis a rss-crit:JudgementBasis ;
    rss-crit:reasoning "Assessor prioritisation policy over the four fundamental safety services named in EN 50159:2010 clause 7.1. EN 50159:2010 does not define the project's critical-violation classes or its payload-specific elevation rules."@en ;
    rss-crit:revisionConditions "Revise when the assessor changes the criticality policy or when authoritative payload semantics replace the EmergencyCommandData and PositionStatusData judgement classes."@en .

rsscr:failsafe-fail-safe-basis a rss-crit:JudgementBasis ;
    rss-crit:reasoning "Assessor propagation model linking explicit safety-function dependencies to incoming critical-violation evidence. It is informed by EN 50126-1:2017, EN 50159:2010 and prTS 50701 D8E4:2020 but is not a rule stated verbatim by those documents."@en ;
    rss-crit:revisionConditions "Revise when the safety architecture or safety-function dependency evidence changes."@en .

rsscr:category-category-basis a rss-crit:JudgementBasis ;
    rss-crit:reasoning "Executable three-valued rendering of Pr1, Pr2 and Pr3 in EN 50159:2010 clauses 6.3.1-6.3.3. Unknown inputs remain undetermined rather than being treated as false."@en ;
    rss-crit:revisionConditions "Revise if the input assertion vocabulary changes or a later EN 50159 edition changes the category preconditions."@en .

rsscr:access-access-basis a rss-crit:JudgementBasis ;
    rss-crit:reasoning "Assessor access-risk policy informed by the maintenance, supplier, remote-access and zoning guidance in prTS 50701 D8E4:2020. Legacy R2.6.1 is re-subjected from a maintenance actor to the safety-critical asset because actors and roles are outside the approved L1-L2 model."@en ;
    rss-crit:revisionConditions "Revise if an actor/role vocabulary is admitted or if the project's access inventory semantics change."@en .

rsscr:threat-threat-basis a rss-crit:JudgementBasis ;
    rss-crit:reasoning "Executable three-valued rendering of EN 50159:2010 clauses 5, 6.4 and 7.4.2. Table 1 is treated as a set of alternative defences, never as a one-defence-per-threat mandate."@en ;
    rss-crit:revisionConditions "Revise if a later EN 50159 edition changes threat applicability or the threats/defences matrix."@en .

### L1 control weakness criteria (IEC 62443-3-3), legacy v3 block 1.1.
rsscr:l1-control-basis a rss-crit:JudgementBasis ;
    rss-crit:reasoning "Assessor mapping from the system capabilities in IEC 62443-3-3:2013 to per-flow observations used for penetration-test scoping. Each control is assessed independently; the standard does not itself define the project's boolean flow properties."@en ;
    rss-crit:revisionConditions "Review the per-flow mapping if the observation model changes or if a later IEC 62443-3-3 edition replaces the 2013 source."@en .

rsscr:l1-authentication-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:iec62443-3-3-sr-1-2-location ;
    rss-crit:determinesApplicabilityOf <https://w3id.org/railsec-scope/rules#AHPAuthenticationFactor> ;
    rss-rail:assessesControlWeakness rss-rail:missingMessageAuthentication ;
    rss-rail:weaknessFlowType rss-rail:VulnerableFlow ;
    rss-crit:restsOnJudgement rsscr:l1-control-basis ;
    rss-crit:appliesInterpretation rsscr:l1-control-interpretation ;
    rss-crit:criterionStatement "Under the assessor's per-flow mapping of IEC 62443-3-3:2013 SR 1.2, a flow without authentication evidence is vulnerable."@en ;
    rss-crit:evaluationStageIdentifier "control-weakness" ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI .

rsscr:l1-integrity-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:iec62443-3-3-sr-3-1-location ;
    rss-crit:determinesApplicabilityOf <https://w3id.org/railsec-scope/rules#AHPIntegrityFactor> ;
    rss-rail:assessesControlWeakness rss-rail:missingIntegrityProtection ;
    rss-rail:weaknessFlowType rss-rail:VulnerableFlow ;
    rss-crit:restsOnJudgement rsscr:l1-control-basis ;
    rss-crit:appliesInterpretation rsscr:l1-control-interpretation ;
    rss-crit:criterionStatement "Under the assessor's per-flow mapping of IEC 62443-3-3:2013 SR 3.1, a flow without communication-integrity protection is vulnerable."@en ;
    rss-crit:evaluationStageIdentifier "control-weakness" ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI .

rsscr:l1-rate-limiting-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:iec62443-3-3-sr-7-1-re-1-location ;
    rss-crit:determinesApplicabilityOf <https://w3id.org/railsec-scope/rules#AHPRateLimitingFactor> ;
    rss-rail:assessesControlWeakness rss-rail:missingRateLimiting ;
    rss-rail:weaknessFlowType rss-rail:DoSExposedFlow ;
    rss-crit:restsOnJudgement rsscr:l1-control-basis ;
    rss-crit:appliesInterpretation rsscr:l1-control-interpretation ;
    rss-crit:criterionStatement "Under the assessor's per-flow mapping of IEC 62443-3-3:2013 SR 7.1 RE 1, a wireless flow without rate limiting is exposed to denial of service."@en ;
    rss-crit:evaluationStageIdentifier "control-weakness" ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI .

rsscr:l1-monitoring-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:iec62443-3-3-sr-6-2-location ;
    rss-crit:determinesApplicabilityOf <https://w3id.org/railsec-scope/rules#AHPLoggingFactor> ;
    rss-rail:assessesControlWeakness rss-rail:missingMonitoring ;
    rss-rail:weaknessFlowType rss-rail:UnauditedFlow ;
    rss-crit:restsOnJudgement rsscr:l1-control-basis ;
    rss-crit:appliesInterpretation rsscr:l1-control-interpretation ;
    rss-crit:criterionStatement "Under the assessor's per-flow mapping of IEC 62443-3-3:2013 SR 6.2, a flow without monitoring evidence is unaudited."@en ;
    rss-crit:evaluationStageIdentifier "control-weakness" ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI .

