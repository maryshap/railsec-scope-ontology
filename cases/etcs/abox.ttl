@prefix case: <https://w3id.org/railsec-scope/case/etcs/resource/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rss-core: <https://w3id.org/railsec-scope/core#> .
@prefix rss-crit: <https://w3id.org/railsec-scope/criteria#> .
@prefix rss-rail: <https://w3id.org/railsec-scope/railway#> .
@prefix rss-res: <https://w3id.org/railsec-scope/results#> .
@prefix rsso: <https://w3id.org/railsec-scope/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/railsec-scope/case/etcs> a owl:Ontology ;
    owl:imports <https://w3id.org/railsec-scope/assessment>,
        <https://w3id.org/railsec-scope/railway> ;
    owl:versionIRI <https://w3id.org/railsec-scope/case/etcs/version/0.1.0> .

case:assumption-ta-01 a rss-core:Assumption ;
    rdfs:comment "The on-board European Vital Computer is assumed to execute only certified and untampered software and logic." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:assertionSubject case:asset-ob-01 ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-02 a rss-core:Assumption ;
    rdfs:comment "Radio communication between train and trackside is assumed to be authenticated and protected according to ETCS specifications." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:assertionSubject case:asset-ob-10,
        case:asset-tc-01a,
        case:interface-if-rad-01 ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-03 a rss-core:Assumption ;
    rdfs:comment "KMC and PKI are assumed to securely generate, distribute and protect cryptographic material." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:assertionSubject case:asset-ct-05 ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-04 a rss-core:Assumption ;
    rdfs:comment "Centralised trackside systems (RBC, IXL, TMS) are assumed to operate in controlled and protected environments." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-05 a rss-core:Assumption ;
    rdfs:comment "Distributed trackside devices are assumed to behave according to configuration and not be maliciously altered." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:assertionSubject case:asset-ts-02 ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-06 a rss-core:Assumption ;
    rdfs:comment "Zones are assumed to enforce separation between on-board, distributed and centralised systems." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-07 a rss-core:Assumption ;
    rdfs:comment "Maintenance personnel are assumed to act according to procedures and not abuse authorised access." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:assertionSubject case:asset-ob-28,
        case:asset-om-01,
        case:asset-om-03b ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-08 a rss-core:Assumption ;
    rdfs:comment "Train drivers and operators are assumed to correctly interpret and act upon system information." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:assertionSubject case:asset-om-03b ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-09 a rss-core:Assumption ;
    rdfs:comment "Commands exchanged between RBC and Interlocking are assumed to be correct and authentic." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:assertionSubject case:asset-ct-01,
        case:asset-ct-02,
        case:interface-if-ct-01 ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-10 a rss-core:Assumption ;
    rdfs:comment "Position and speed data used by EVC are assumed to be accurate and not manipulated." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:assertionSubject case:asset-ob-01,
        case:asset-ob-02,
        case:asset-ts-01 ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-11 a rss-core:Assumption ;
    rdfs:comment "Juridical recording units are assumed to correctly and immutably store event logs." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:assertionSubject case:asset-ct-07,
        case:asset-ob-09 ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-12 a rss-core:Assumption ;
    rdfs:comment "Delivered equipment is assumed to be genuine and uncompromised at installation time." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:assertionSubject case:asset-ct-05,
        case:asset-ct-06,
        case:asset-sc-02 ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-13 a rss-core:Assumption ;
    rdfs:comment "Physical protection measures (technical room) are in place to prevent unauthorized physical access to centralised trackside equipment." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-14 a rss-core:Assumption ;
    rdfs:comment "Support/telecom services are located in a fenced/controlled area, limiting physical tampering and casual access." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-15 a rss-core:Assumption ;
    rdfs:comment "Only minimal authorized staff and controlled devices can access the O&M zone; temporary devices are supervised and logged." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-16 a rss-core:Assumption ;
    rdfs:comment "Critical systems are not directly exposed; external access requires at least two independent barriers (e.g., network segmentation + authentication)." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:assumption-ta-17 a rss-core:Assumption ;
    rdfs:comment "Maintenance server(s) are not permitted to issue safety commands to RBC/IXL; only read-only diagnostics allowed." ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#trusted"^^xsd:anyURI ;
    rss-core:assertionSubject case:asset-ct-01,
        case:asset-ct-02,
        case:asset-ob-28 ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

