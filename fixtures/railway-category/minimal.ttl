# Criteria and judgement bases were moved to ontology/criteria-railway.ttl.
# This fixture supplies instance data only, so the same criteria apply here
# and to every case.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fx: <https://w3id.org/railsec-scope/fixture/railway-category/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rss-core: <https://w3id.org/railsec-scope/core#> .
@prefix rss-crit: <https://w3id.org/railsec-scope/criteria#> .
@prefix rss-rail: <https://w3id.org/railsec-scope/railway#> .
@prefix rss-res: <https://w3id.org/railsec-scope/results#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fx:cat1-control a rss-rail:EnvironmentControlFact ;
    rss-core:hasEpistemicStatus rss-core:assertedFactStatus ;
    rss-rail:environmentControlledValue true ;
    rss-rail:transmissionAssertionSubject fx:cat1-flow ;
    rss-res:assertedInInstanceSet fx:instance-set .

fx:cat1-fixed a rss-rail:ParticipantSetFixedFact ;
    rss-core:hasEpistemicStatus rss-core:assertedFactStatus ;
    rss-rail:participantSetFixedValue true ;
    rss-rail:transmissionAssertionSubject fx:cat1-flow ;
    rss-res:assertedInInstanceSet fx:instance-set .

fx:cat2-access a rss-rail:UnauthorisedAccessExclusionAssumption ;
    prov:wasAttributedTo fx:assessor ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-rail:transmissionAssertionSubject fx:cat2-flow ;
    rss-rail:unauthorisedAccessExcludedValue true ;
    rss-res:assertedInInstanceSet fx:instance-set .

fx:cat2-control a rss-rail:EnvironmentControlFact ;
    rss-core:hasEpistemicStatus rss-core:assertedFactStatus ;
    rss-rail:environmentControlledValue false ;
    rss-rail:transmissionAssertionSubject fx:cat2-flow ;
    rss-res:assertedInInstanceSet fx:instance-set .

fx:cat2-fixed a rss-rail:ParticipantSetFixedFact ;
    rss-core:hasEpistemicStatus rss-core:assertedFactStatus ;
    rss-rail:participantSetFixedValue false ;
    rss-rail:transmissionAssertionSubject fx:cat2-flow ;
    rss-res:assertedInInstanceSet fx:instance-set .

fx:cat3-access a rss-rail:UnauthorisedAccessExclusionAssumption ;
    prov:wasAttributedTo fx:assessor ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-rail:transmissionAssertionSubject fx:cat3-flow ;
    rss-rail:unauthorisedAccessExcludedValue false ;
    rss-res:assertedInInstanceSet fx:instance-set .

fx:cat3-control a rss-rail:EnvironmentControlFact ;
    rss-core:hasEpistemicStatus rss-core:assertedFactStatus ;
    rss-rail:environmentControlledValue false ;
    rss-rail:transmissionAssertionSubject fx:cat3-flow ;
    rss-res:assertedInInstanceSet fx:instance-set .

fx:cat3-fixed a rss-rail:ParticipantSetFixedFact ;
    rss-core:hasEpistemicStatus rss-core:assertedFactStatus ;
    rss-rail:participantSetFixedValue false ;
    rss-rail:transmissionAssertionSubject fx:cat3-flow ;
    rss-res:assertedInInstanceSet fx:instance-set .

fx:no-input-flow a rss-rail:RailwayInformationFlow .

fx:run a rss-res:Run ;
    rss-res:runIdentifier "category-slice-run" ;
    rss-res:usedInstanceSet fx:instance-set .

fx:unknown-control a rss-rail:EnvironmentControlFact ;
    rss-core:hasEpistemicStatus rss-core:assertedFactStatus ;
    rss-rail:environmentControlledValue false ;
    rss-rail:transmissionAssertionSubject fx:unknown-flow ;
    rss-res:assertedInInstanceSet fx:instance-set .

fx:unknown-fixed a rss-rail:ParticipantSetFixedFact ;
    rss-core:hasEpistemicStatus rss-core:assertedFactStatus ;
    rss-rail:participantSetFixedValue false ;
    rss-rail:transmissionAssertionSubject fx:unknown-flow ;
    rss-res:assertedInInstanceSet fx:instance-set .

fx:version a rss-crit:ArtefactVersion ;
    rss-crit:versionIdentifier "category-slice-1" .

fx:assessor a prov:Agent .

fx:cat1-flow a rss-rail:RailwayInformationFlow .

fx:unknown-flow a rss-rail:RailwayInformationFlow .

fx:cat2-flow a rss-rail:RailwayInformationFlow .

fx:cat3-flow a rss-rail:RailwayInformationFlow .

fx:instance-set a rss-res:InstanceSet ;
    dcterms:source "Purpose-built synthetic category fixture; not railway evidence."@en ;
    rss-crit:hasVersion fx:version .
