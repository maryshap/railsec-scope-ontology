    rss-crit:derivedFromSourceLocation rsscr:iec62443-3-3-fr-4-location, rsscr:ts50701-6-3-1-location ;
    rss-crit:determinesApplicabilityOf <https://w3id.org/railsec-scope/rules#AHPConfidentialityFactor> ;
