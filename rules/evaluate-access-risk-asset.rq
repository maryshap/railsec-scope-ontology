PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rss-core: <https://w3id.org/railsec-scope/core#>
PREFIX rss-crit: <https://w3id.org/railsec-scope/criteria#>
PREFIX rss-rail: <https://w3id.org/railsec-scope/railway#>
PREFIX rss-res: <https://w3id.org/railsec-scope/results#>
PREFIX rss-rule: <https://w3id.org/railsec-scope/rules#>

# M5-R07 privileged access risk on a safety-critical asset (legacy v3 R2.6.1,
# R2.6.3). An asset with no recorded access mechanism at all is undetermined:
# an unstated access inventory is not evidence of absence.

CONSTRUCT {
  ?evaluation a rss-res:CriterionEvaluation ;
      rss-res:evaluationConcernsElement ?asset ;
      rss-res:evaluatesCriterion ?criterion ;
      rss-res:hasEvaluationOutcome ?outcome ;
      rss-res:hasDerivationRecord ?record ;
      rss-res:producedByRun ?run .
  ?record a rss-res:DerivationRecord ;
      rss-res:hasStep ?step ;
      rss-res:completenessStatus ?completeness .
  ?step a rss-res:DerivationStep ;
      rss-res:stepPosition 1 ;
      rss-res:layerIdentifier "L2" ;
      rss-res:appliedCriterion ?criterion ;
      rss-res:executedByMechanism rss-rule:EvaluateAssetAccessRisk ;
      prov:used ?asset ;
      rss-res:generatedResult ?evaluation .
}
WHERE {
  ?asset a rss-rail:SafetyCriticalAsset .
  ?run a rss-res:Run .
  ?criterion a rss-crit:Criterion ;
      rss-rail:assessesAccessRisk ?risk ;
      rss-rail:assessesAccessMechanism ?mechanismClass .
  FILTER(?risk = rss-rail:privilegedMaintenanceAccessRisk || ?risk = rss-rail:privilegedSupplierAccessRisk)

  BIND(EXISTS { ?asset rss-core:reachableBy ?anyMechanism . } AS ?inventoryStated)
  BIND(EXISTS { ?asset rss-core:reachableBy ?matched . ?matched rdf:type ?mechanismClass . } AS ?mechanismPresent)

  BIND(IF(!?inventoryStated, rss-res:undetermined,
          IF(?mechanismPresent, rss-res:satisfied, rss-res:notSatisfied)) AS ?outcome)
  BIND(IF(?outcome = rss-res:undetermined, "incomplete", "complete") AS ?completeness)
  BIND(IRI(CONCAT(STR(?asset), "/evaluation/access/", ENCODE_FOR_URI(STRAFTER(STR(?risk), "#")), "/run/", MD5(STR(?run)))) AS ?evaluation)
  BIND(IRI(CONCAT(STR(?evaluation), "/derivation")) AS ?record)
  BIND(IRI(CONCAT(STR(?evaluation), "/step/1")) AS ?step)
  FILTER(isIRI(?asset) && isIRI(?run) && isIRI(?criterion) && isIRI(?risk))
}
