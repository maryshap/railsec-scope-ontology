rsscr:category-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:en50159-6-2-location, rsscr:en50159-6-3-location, rsscr:en50159-6-4-location ;
    rss-crit:interpretationProposition "EN 50159 transmission categories are evaluated from controlled environment, fixed participant set and unauthorised-access exclusion inputs; category membership is then materialised only from a satisfied evaluation." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:threat-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:en50159-5-2-1-location, rsscr:en50159-5-2-2-location, rsscr:en50159-5-2-3-location, rsscr:en50159-5-2-4-location, rsscr:en50159-5-2-5-location, rsscr:en50159-5-2-6-location, rsscr:en50159-5-2-7-location ;
    rss-crit:interpretationProposition "The seven EN 50159 transmission-threat classes are represented as three-valued CriterionEvaluation results over railway information flows, preserving undetermined upstream category or control inputs." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:critical-violation-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:en50159-7-1-location, rsscr:en50159-7-2-location, rsscr:en50159-7-3-location ;
    rss-crit:interpretationProposition "Critical-violation criteria elevate satisfied transmission-threat evaluations when the flow carries the required safety-related payload class; missing payload classification remains undetermined." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:failsafe-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:en50126-4-location, rsscr:en50159-3-1-52-location, rsscr:ts50701-annex-d-p1-location ;
    rss-crit:interpretationProposition "Fail-safe compromise is evaluated only through explicit safety-function realisation, fail-safe dependency and incoming critical-violation evidence, so missing dependency information remains undetermined." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:sil-risk-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:iec61508-location, rsscr:en50126-4-location ;
    rss-crit:interpretationProposition "Maximum SIL risk is represented as a derived evaluation of a safety-critical asset whose fail-safe compromise is satisfied; explicit SIL allocation remains safety-case evidence rather than an information-security scoping input." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:access-risk-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:ts50701-3-1-60-location, rsscr:ts50701-7-2-location, rsscr:ts50701-7-2-2-location ;
    rss-crit:interpretationProposition "Maintenance, supplier and remote access are evaluated from explicit access mechanisms on assets or flow origins; an unstated access inventory remains undetermined rather than negative." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:l1-control-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:iec62443-3-3-fr-4-location, rsscr:iec62443-3-3-sr-3-1-location, rsscr:iec62443-3-3-sr-5-1-location, rsscr:iec62443-3-3-sr-6-1-location, rsscr:iec62443-3-3-sr-7-2-location, rsscr:ts50701-6-3-1-location ;
    rss-crit:interpretationProposition "Implemented L1 control-weakness criteria assess absence of authentication, integrity protection, encryption, rate limiting, segmentation and monitoring as independent control findings." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:zone-exposure-basis a rss-crit:JudgementBasis ;
    rss-crit:reasoning "Refactoring of legacy R1.2.1, R1.2.2 and R2.1.4. Zone membership is treated as architecture data; exposure and Category 3 asset context are derived classifications with source/provenance."@en ;
    rss-crit:revisionConditions "Replace with reviewed IEC 62443-3-2 and EN 50159 source locations if the final standards review changes the admitted zone terminology."@en .

rsscr:zone-exposure-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:iec62443-3-2-6-location, rsscr:en50159-6-3-location ;
    rss-crit:interpretationProposition "Asset exposure and Category 3 asset context are derived from explicit asset membership in external or partially trusted railway security zones." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:entry-point-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:iec62443-3-2-6-location ;
    rss-crit:interpretationProposition "Entry-point candidacy is derived from explicit asset membership in external or DMZ railway security zones; later ATT&CK-specific entry-point rules are kept for the L3 layer." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:remediation-priority-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:ts50701-location, rsscr:en50126-4-location ;
    rss-crit:interpretationProposition "High-priority remediation is derived only when a safety-critical asset has a satisfied fail-safe compromise evaluation and is explicitly placed in a mobile railway zone." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .
