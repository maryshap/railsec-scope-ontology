@prefix fx: <https://w3id.org/railsec-scope/fixture/criterion-positive/> .
@prefix rss-core: <https://w3id.org/railsec-scope/core#> .
@prefix rss-crit: <https://w3id.org/railsec-scope/criteria#> .
@prefix rss-res: <https://w3id.org/railsec-scope/results#> .

fx:run a rss-res:Run .
fx:element a rss-core:Element .
fx:criterion a rss-crit:Criterion ;
    rss-crit:determinesMembershipOf rss-crit:CandidateExaminationTarget .
fx:evaluation a rss-res:CriterionEvaluation ;
    rss-res:evaluationConcernsElement fx:element ;
    rss-res:evaluatesCriterion fx:criterion ;
    rss-res:hasEvaluationOutcome rss-res:satisfied ;
    rss-res:producedByRun fx:run .
fx:record a rss-res:DerivationRecord .
fx:assignment a rss-res:CategoryAssignment ;
    rss-res:materialisesEvaluation fx:evaluation ;
    rss-res:assignsCategory rss-crit:CandidateExaminationTarget ;
    rss-res:hasDerivationRecord fx:record ;
    rss-res:producedByRun fx:run .
