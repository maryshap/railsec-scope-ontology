<https://w3id.org/railsec-scope/case/etcs/scenario/protected-baseline/security-facts> a owl:Ontology ;
    owl:imports <https://w3id.org/railsec-scope/assessment>,
        <https://w3id.org/railsec-scope/railway> ;
    owl:versionIRI <https://w3id.org/railsec-scope/case/etcs/scenario/protected-baseline/security-facts/version/0.1.0> .

# Scenario: protected-baseline.
#
# Same 88 interfaces and the same 7 protection-control properties as the
# legacy-derived cases/etcs/security-facts.ttl, but every value is set to
# the protective state (true). This is a hypothetical best case built for
# scenario comparison, not a transferred workbook value: it does not carry
# case:legacy-security-fact-basis provenance, and it is not evidence about
# the real ETCS deployment. See SCENARIO.md in this directory.

case:scenario-protected-baseline-basis a rss-crit:JudgementBasis ;
    rss-crit:reasoning "Every protection-control property on every interface is set to its protective value (true) to construct a hypothetical best-achievable state for scenario comparison. This is not derived from the legacy workbook or from any architecture evidence; it is a deliberately idealised counterfactual used as the reference point against which single-control-degradation and other scenarios are compared."@en ;
    rss-crit:revisionConditions "Not applicable: this basis exists only to support scenario comparison and is never promoted to a case fact about the real ETCS deployment."@en .

case:IF-CT-01-authenticationEnabled-protected-assumption a rss-core:Assumption ;
    prov:wasAttributedTo case:assessor ;
    prov:wasDerivedFrom case:scenario-protected-baseline-basis ;
    rss-core:assertionObjectLiteral true ;
    rss-core:assertionPredicateIri "https://w3id.org/railsec-scope/railway#authenticationEnabled"^^xsd:anyURI ;
    rss-core:assertionSubject case:interface-if-ct-01 ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set .

case:IF-CT-01-encryptionEnabled-protected-assumption a rss-core:Assumption ;
