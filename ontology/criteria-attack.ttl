<https://w3id.org/railsec-scope/criteria/attack> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/railsec-scope/version/0.1.0/criteria/attack> ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://w3id.org/railsec-scope/attack/ics/19.2>,
        <https://w3id.org/railsec-scope/criteria/railway> ;
    rsso:moduleCode "M7C" ;
    rsso:termNamespace "https://w3id.org/railsec-scope/criteria/attack/"^^xsd:anyURI ;
    dcterms:title "RailSec Scope Ontology — M7 attack applicability criteria"@en ;
    dcterms:description "Sourced criteria that project L1/L2 railway assessment outcomes into three-valued ATT&CK ICS technique-applicability evaluations. They support test planning and do not assert exploitability or attack occurrence."@en .

rssca:criteria-module-version a rss-crit:ArtefactVersion ;
    rss-crit:versionIdentifier "0.1.0-l3" .

### Controlled applicability criteria

rssca:t0842-network-sniffing-confidentiality-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rssca:criteria-module-version ;
    rss-crit:lifecycleStatus "active" ;
    rss-crit:derivedFromSourceLocation rssca:t0842-location ;
    rss-crit:appliesInterpretation rssca:t0842-confidentiality-interpretation ;
    rss-crit:criterionStatement "Within the declared railway applicability profile, ATT&CK ICS T0842 Network Sniffing is relevant to a RailwayInformationFlow when that same flow has a satisfied L1 confidentiality-weakness evaluation."@en ;
    rss-crit:evaluationStageIdentifier "attack-technique-applicability" ;
    rss-crit:stageCandidateTypeIri "https://w3id.org/railsec-scope/railway#RailwayInformationFlow"^^xsd:anyURI ;
    rss-attack:assessesAttackTechnique <https://w3id.org/railsec-scope/attack/ics/19.2/technique/T0842> ;
    rss-attack:requiresSatisfiedEvaluationOf rsscr:l1-confidentiality-criterion .

