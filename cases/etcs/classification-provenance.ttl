# Identity assertions. The architecture description supports the existence and
# naming of these components. It is not cited for the classification above.

case:asset-ob-24-identity-assertion a rss-core:Assumption ;
    rdfs:label "Existence and identity of Odometry Module"@en ;
    rss-core:assertionSubject case:asset-ob-24 ;
    rss-core:assertionPredicateIri "http://www.w3.org/2000/01/rdf-schema#label"^^xsd:anyURI ;
    rss-core:assertionObjectLiteral "Odometry Module" ;
    rss-core:hasEpistemicStatus rss-core:assumptionStatus ;
    rss-res:assertedInInstanceSet case:instance-set ;
    prov:wasDerivedFrom case:asset-identity-basis ;
    prov:wasAttributedTo case:assessor .

