rsscr:mobile-zone-remediation-criterion a rss-crit:Criterion ;
    rss-crit:hasVersion rsscr:criteria-module-version ;
    rss-crit:derivedFromSourceLocation rsscr:ts50701-5-5-4-location, rsscr:ts50701-6-5-3-location ;
    rss-crit:criterionStatement "Under the assessor's remediation policy informed by prTS 50701 D8E4:2020, a safety-critical asset with a satisfied fail-safe compromise in a mobile railway zone requires high-priority remediation."@en ;
    rss-crit:evaluationStageIdentifier "remediation-priority" ;
    rss-crit:appliesInterpretation rsscr:remediation-priority-interpretation ;
    rss-crit:restsOnJudgement rsscr:failsafe-fail-safe-basis ;
