rsscr:category-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:en50159-6-3-1-location, rsscr:en50159-6-3-2-location, rsscr:en50159-6-3-3-location ;
    rss-crit:interpretationProposition "EN 50159:2010 Category 1 requires Pr1, Pr2 and Pr3; Category 2 requires failure of Pr1 or Pr2 together with satisfaction of Pr3; Category 3 follows from failure of Pr3 independently of Pr1 and Pr2." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:threat-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:en50159-5-location, rsscr:en50159-6-4-location, rsscr:en50159-7-4-2-location ;
    rss-crit:interpretationProposition "The seven EN 50159:2010 Clause 5 threats are three-valued evaluations. Table 1 defences are alternatives: any explicitly enabled listed defence protects the flow; exposure requires every listed alternative to be explicitly absent; a partial inventory remains undetermined. All threats apply to all categories except masquerade, which applies only to open Categories 2 and 3." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:critical-violation-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:en50159-7-1-location ;
    rss-crit:interpretationProposition "EN 50159:2010 identifies authenticity, integrity, timeliness and sequence as fundamental safety services. The project's elevation of particular threat/payload combinations to critical violations is an assessor prioritisation policy, not a classification stated by the standard; missing payload classification remains undetermined." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:failsafe-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:en50126-1-3-68-location, rsscr:en50159-3-1-52-location, rsscr:ts50701-5-5-4-location ;
    rss-crit:interpretationProposition "EN 50126-1:2017 defines safety functions, EN 50159:2010 defines the safety-related transmission function, and prTS 50701 D8E4:2020 requires safety information to feed cybersecurity assessment. The project's fail-safe compromise propagation is an assessor model over explicit function dependencies; missing dependency information remains undetermined." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:sil-risk-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:en50126-1-3-70-location, rsscr:en50126-2-10-2-8-location ;
    rss-crit:interpretationProposition "EN 50126-1:2017 and EN 50126-2:2017 allocate SIL to safety-related electronic functions through the safety process. The derived result is therefore only an assessor's safety-integrity scoping concern; it neither infers nor allocates a SIL. Any SIL value must be supplied as a separately attributed assessor assignment or safety-case fact." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:access-risk-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:ts50701-3-1-59-location, rsscr:ts50701-6-5-2-location ;
    rss-crit:interpretationProposition "prTS 50701 D8E4:2020 defines remote access and gives explicit maintenance-access zoning guidance. The project's maintenance, supplier and remote-access risk classifications are assessor policies evaluated from explicit access inventories; an unstated inventory remains undetermined rather than negative." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:l1-control-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:iec62443-3-3-fr-4-location, rsscr:iec62443-3-3-sr-1-2-location, rsscr:iec62443-3-3-sr-3-1-location, rsscr:iec62443-3-3-sr-5-1-location, rsscr:iec62443-3-3-sr-6-2-location, rsscr:iec62443-3-3-sr-7-1-re-1-location, rsscr:ts50701-6-3-1-location ;
    rss-crit:interpretationProposition "Implemented L1 control-weakness criteria assess absence of authentication, integrity protection, encryption, rate limiting, segmentation and monitoring as independent control findings." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:zone-exposure-basis a rss-crit:JudgementBasis ;
    rss-crit:reasoning "Refactoring of legacy R1.2.1, R1.2.2 and R2.1.4. Zone membership is treated as architecture data; exposure and Category 3 asset context are derived classifications with source/provenance."@en ;
    rss-crit:revisionConditions "Replace with reviewed IEC 62443-3-2 and EN 50159 source locations if the final standards review changes the admitted zone terminology."@en .

rsscr:zone-exposure-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:ts50701-6-5-3-location, rsscr:en50159-6-3-3-location ;
    rss-crit:interpretationProposition "prTS 50701 D8E4:2020 requires zones and conduits to be defined and documented. External/partially-trusted labels and the projection of EN 50159:2010 Category 3 context from transmissions to assets are explicit assessor taxonomies, not standard-defined asset classes." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:entry-point-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:ts50701-3-1-32-location, rsscr:ts50701-6-5-3-location ;
    rss-crit:interpretationProposition "prTS 50701 D8E4:2020 defines a DMZ and requires zone/conduit documentation. Treating assets in external or DMZ zones as entry-point candidates is an assessor attack-surface policy; ATT&CK-specific entry-point rules remain in L3." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .

rsscr:remediation-priority-interpretation a rss-crit:Interpretation ;
    rss-crit:interprets rsscr:ts50701-5-5-4-location, rsscr:ts50701-6-5-3-location ;
    rss-crit:interpretationProposition "The high-priority result is an assessor remediation policy combining safety impact and an explicitly assigned mobile-zone context; prTS 50701 D8E4:2020 does not define the project's MobileZone class or this exact priority rule." ;
    rss-crit:interpretationConfidence "reasoned" ;
    rss-crit:reviewStatus "source locations formalised from reviewed project evidence" .
