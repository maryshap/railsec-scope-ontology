PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rss-crit: <https://w3id.org/railsec-scope/criteria#>
PREFIX rss-rail: <https://w3id.org/railsec-scope/railway#>
PREFIX rss-res: <https://w3id.org/railsec-scope/results#>
PREFIX rss-rule: <https://w3id.org/railsec-scope/rules#>
PREFIX rsscr: <https://w3id.org/railsec-scope/criteria/railway/>

CONSTRUCT {
  ?evaluation a rss-res:CriterionEvaluation ;
      rss-res:evaluationConcernsElement ?flow ;
      rss-res:evaluatesCriterion ?criterion ;
      rss-res:hasEvaluationOutcome ?outcome ;
      rss-res:hasDerivationRecord ?record ;
      rss-res:producedByRun ?run .
  ?record a rss-res:DerivationRecord ;
      rss-res:hasStep ?step ;
      rss-res:completenessStatus ?completeness .
  ?step a rss-res:DerivationStep ;
      rss-res:stepPosition 1 ;
      rss-res:layerIdentifier "L2" ;
      rss-res:appliedCriterion ?criterion ;
      rss-res:executedByMechanism rss-rule:EvaluateTransmissionThreat ;
      rss-res:usedEntity ?cat1Evaluation, ?cat2Evaluation, ?cat3Evaluation ;
      prov:used ?flow ;
      rss-res:generatedResult ?evaluation .
}
WHERE {
  ?flow a rss-rail:RailwayInformationFlow .
  ?run a rss-res:Run .
  VALUES (?threat ?criterion) {
    (rss-rail:RepetitionThreat rsscr:threat-repetition-criterion)
    (rss-rail:DeletionThreat rsscr:threat-deletion-criterion)
    (rss-rail:InsertionThreat rsscr:threat-insertion-criterion)
    (rss-rail:ResequencingThreat rsscr:threat-resequencing-criterion)
    (rss-rail:CorruptionThreat rsscr:threat-corruption-criterion)
    (rss-rail:DelayThreat rsscr:threat-delay-criterion)
    (rss-rail:MasqueradeThreat rsscr:threat-masquerade-criterion)
  }
  ?criterion a rss-crit:Criterion ;
      rss-rail:assessesTransmissionThreat ?threat .

  BIND(IRI(CONCAT(STR(?flow), "/evaluation/Category1Transmission/run/", MD5(STR(?run)))) AS ?cat1Evaluation)
  BIND(IRI(CONCAT(STR(?flow), "/evaluation/Category2Transmission/run/", MD5(STR(?run)))) AS ?cat2Evaluation)
  BIND(IRI(CONCAT(STR(?flow), "/evaluation/Category3Transmission/run/", MD5(STR(?run)))) AS ?cat3Evaluation)
  OPTIONAL {
    ?cat1Evaluation rss-res:evaluationConcernsElement ?flow ;
        rss-res:hasEvaluationOutcome ?cat1Outcome ;
        rss-res:producedByRun ?run .
  }
  OPTIONAL {
    ?cat2Evaluation rss-res:evaluationConcernsElement ?flow ;
        rss-res:hasEvaluationOutcome ?cat2Outcome ;
        rss-res:producedByRun ?run .
  }
  OPTIONAL {
    ?cat3Evaluation rss-res:evaluationConcernsElement ?flow ;
        rss-res:hasEvaluationOutcome ?cat3Outcome ;
        rss-res:producedByRun ?run .
  }

  OPTIONAL { ?flow rss-rail:sequenceNumberEnabled ?sequenceNumber . }
  OPTIONAL { ?flow rss-rail:timestampEnabled ?timestamp . }
  OPTIONAL { ?flow rss-rail:timeoutMechanismEnabled ?timeoutMechanism . }
  OPTIONAL { ?flow rss-rail:sourceDestinationIdentifierEnabled ?sourceDestinationIdentifier . }
  OPTIONAL { ?flow rss-rail:feedbackMessageEnabled ?feedbackMessage . }
  OPTIONAL { ?flow rss-rail:identificationProcedureEnabled ?identificationProcedure . }
  OPTIONAL { ?flow rss-rail:safetyCodeEnabled ?safetyCode . }
  OPTIONAL { ?flow rss-rail:cryptographicMessageProtectionEnabled ?cryptographicProtection . }

  BIND(IF(BOUND(?cat1Outcome), ?cat1Outcome = rss-res:satisfied, false) AS ?cat1Satisfied)
  BIND(IF(BOUND(?cat2Outcome), ?cat2Outcome = rss-res:satisfied, false) AS ?cat2Satisfied)
  BIND(IF(BOUND(?cat3Outcome), ?cat3Outcome = rss-res:satisfied, false) AS ?cat3Satisfied)
  # EN 50159:2010, 6.4 makes every Clause 5 threat applicable to every
  # transmission category except masquerade, which applies only to the open
  # Categories 2 and 3.
  BIND(?threat = rss-rail:MasqueradeThreat AS ?openSystemOnly)
  BIND(?openSystemOnly && ?cat1Satisfied AS ?notApplicable)
  BIND(IF(?openSystemOnly, (?cat2Satisfied || ?cat3Satisfied), true) AS ?applicable)

  # EN 50159:2010, 7.4.2 Table 1 is an alternatives matrix.  A threat is
  # protected when any listed defence is explicitly true.  Exposure is
  # asserted only when every listed alternative is explicitly known and false;
  # a partial inventory without a positive defence remains undetermined.
  BIND(
    IF(?threat = rss-rail:RepetitionThreat || ?threat = rss-rail:ResequencingThreat,
       BOUND(?sequenceNumber) && BOUND(?timestamp),
       IF(?threat = rss-rail:DeletionThreat,
          BOUND(?sequenceNumber),
          IF(?threat = rss-rail:InsertionThreat,
             BOUND(?sequenceNumber) && BOUND(?sourceDestinationIdentifier) &&
             BOUND(?feedbackMessage) && BOUND(?identificationProcedure),
             IF(?threat = rss-rail:CorruptionThreat,
                BOUND(?safetyCode) && BOUND(?cryptographicProtection),
                IF(?threat = rss-rail:DelayThreat,
                   BOUND(?timestamp) && BOUND(?timeoutMechanism),
                   BOUND(?feedbackMessage) && BOUND(?identificationProcedure) &&
                   BOUND(?cryptographicProtection))))))
    AS ?allAlternativesKnown
  )
  BIND(
    IF(?threat = rss-rail:RepetitionThreat || ?threat = rss-rail:ResequencingThreat,
       (BOUND(?sequenceNumber) && ?sequenceNumber = true) ||
       (BOUND(?timestamp) && ?timestamp = true),
       IF(?threat = rss-rail:DeletionThreat,
          BOUND(?sequenceNumber) && ?sequenceNumber = true,
          IF(?threat = rss-rail:InsertionThreat,
             (BOUND(?sequenceNumber) && ?sequenceNumber = true) ||
             (BOUND(?sourceDestinationIdentifier) && ?sourceDestinationIdentifier = true) ||
             (BOUND(?feedbackMessage) && ?feedbackMessage = true) ||
             (BOUND(?identificationProcedure) && ?identificationProcedure = true),
             IF(?threat = rss-rail:CorruptionThreat,
                (BOUND(?safetyCode) && ?safetyCode = true) ||
                (BOUND(?cryptographicProtection) && ?cryptographicProtection = true),
                IF(?threat = rss-rail:DelayThreat,
                   (BOUND(?timestamp) && ?timestamp = true) ||
                   (BOUND(?timeoutMechanism) && ?timeoutMechanism = true),
                   (BOUND(?feedbackMessage) && ?feedbackMessage = true) ||
                   (BOUND(?identificationProcedure) && ?identificationProcedure = true) ||
                   (BOUND(?cryptographicProtection) && ?cryptographicProtection = true))))))
    AS ?anyAlternativeEnabled
  )
  BIND(
    IF(?anyAlternativeEnabled, rss-res:notSatisfied,
       IF(?allAlternativesKnown, rss-res:satisfied, rss-res:undetermined))
    AS ?protectionOutcome
  )
  BIND(
    IF(?notApplicable, rss-res:notSatisfied,
       IF(?applicable, ?protectionOutcome, rss-res:undetermined))
    AS ?outcome
  )
  BIND(IF(?outcome = rss-res:undetermined, "incomplete", "complete") AS ?completeness)
  BIND(IRI(CONCAT(STR(?flow), "/evaluation/threat/", ENCODE_FOR_URI(STRAFTER(STR(?threat), "#")), "/run/", MD5(STR(?run)))) AS ?evaluation)
  BIND(IRI(CONCAT(STR(?evaluation), "/derivation")) AS ?record)
  BIND(IRI(CONCAT(STR(?evaluation), "/step/1")) AS ?step)
  FILTER(isIRI(?flow) && isIRI(?run) && isIRI(?criterion) && isIRI(?threat))
}
