@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rss-crit: <https://w3id.org/railsec-scope/criteria#> .
@prefix rss-res: <https://w3id.org/railsec-scope/results#> .
@prefix rss-rule: <https://w3id.org/railsec-scope/rules#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/railsec-scope/rules> a owl:Ontology ;
    owl:imports <https://w3id.org/railsec-scope/results> ;
    dcterms:title "RailSec Scope declared DL-safe rule profile"@en .

rss-rule:CandidateFromSatisfiedEvaluation a rss-rule:DLSafeRule ;
    rss-rule:implementationFile "classify-candidate.rq" ;
    rss-rule:ruleIdentifier "L2-R01" ;
    rss-rule:enabled true ;
    dcterms:description "A satisfied evaluation of a criterion that determines an assessment-bearing category entails that category membership for the named element. The historical identifier is retained for compatibility although the implementation is now category-generic."@en .

rss-rule:phase2RuleVersion a rss-crit:ArtefactVersion ;
    rss-crit:versionIdentifier "0.1.0-phase2" .

rss-rule:EvaluateTransmissionCategory a rss-rule:DLSafeRule, rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    rss-rule:implementationFile "evaluate-transmission-category.rq" ;
    rss-rule:ruleIdentifier "M5-R01" ;
    rss-rule:enabled true ;
    dcterms:description "Produces three-valued CriterionEvaluation records from attributed category inputs; it does not assert category membership."@en .

rss-rule:ClassifyTransmissionCategory a rss-rule:DLSafeRule, rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    rss-rule:implementationFile "classify-transmission-category.rq" ;
    rss-rule:ruleIdentifier "M5-R02" ;
    rss-rule:enabled true ;
    dcterms:description "Entails EN 50159 category membership only from a satisfied CriterionEvaluation."@en .

rss-rule:EvaluateTransmissionThreat a rss-rule:DLSafeRule, rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    rss-rule:implementationFile "evaluate-transmission-threat.rq" ;
    rss-rule:ruleIdentifier "M5-R03" ;
    rss-rule:enabled true ;
    dcterms:description "Produces three-valued evaluations for the seven EN 50159 transmission threats. It consumes upstream category evaluations and never types a flow as a threat class."@en .

rss-rule:EvaluateCriticalViolation a rss-rule:DLSafeRule, rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    rss-rule:implementationFile "evaluate-critical-violation.rq" ;
    rss-rule:ruleIdentifier "M5-R04" ;
    rss-rule:enabled true ;
    dcterms:description "Elevates a satisfied transmission-threat evaluation to a critical violation evaluation when the flow carries a safety-related payload. Consumes threat CriterionEvaluation records rather than class membership, and propagates undetermined from either the threat outcome or an unknown payload classification."@en .

rss-rule:EvaluateFailSafeCompromise a rss-rule:DLSafeRule, rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    rss-rule:implementationFile "evaluate-fail-safe-compromise.rq" ;
    rss-rule:ruleIdentifier "M5-R05" ;
    rss-rule:enabled true ;
    dcterms:description "Produces three-valued fail-safe compromise evaluations for safety-critical assets from explicit fail-safe dependencies and upstream critical-violation evaluations. It never types an asset as a legacy FailSafeVulnerability."@en .

rss-rule:EvaluateSILRisk a rss-rule:DLSafeRule, rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    rss-rule:implementationFile "evaluate-sil-risk.rq" ;
    rss-rule:ruleIdentifier "M5-R06" ;
    rss-rule:enabled true ;
    dcterms:description "Aggregates fail-safe compromise evaluations of a safety-critical asset into a maximum SIL risk evaluation. Consumes evaluations rather than class membership and never types an asset with a risk class."@en .

rss-rule:EvaluateAssetAccessRisk a rss-rule:DLSafeRule, rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    rss-rule:implementationFile "evaluate-access-risk-asset.rq" ;
    rss-rule:ruleIdentifier "M5-R07" ;
    rss-rule:enabled true ;
    dcterms:description "Evaluates privileged maintenance and supplier access risk on safety-critical assets. An unstated access inventory yields undetermined rather than a negative conclusion."@en .

rss-rule:EvaluateAccessPathRisk a rss-rule:DLSafeRule, rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    rss-rule:implementationFile "evaluate-access-path-risk.rq" ;
    rss-rule:ruleIdentifier "M5-R08" ;
    rss-rule:enabled true ;
    dcterms:description "Evaluates high-risk maintenance paths and remote access risk on information flows. Remote access risk consumes transmission-threat evaluations and propagates their undetermined outcomes."@en .

rss-rule:EvaluateControlWeakness a rss-rule:DLSafeRule, rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    rss-rule:implementationFile "evaluate-control-weakness.rq" ;
    rss-rule:ruleIdentifier "M5-R09" ;
    rss-rule:enabled true ;
    dcterms:description "Assesses IEC 62443-3-3 controls on flows independently; an unstated control yields undetermined rather than a weakness."@en .

rss-rule:ClassifyVulnerableFlow a rss-rule:DLSafeRule, rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    rss-rule:implementationFile "classify-vulnerable-flow.rq" ;
    rss-rule:ruleIdentifier "M5-R10" ;
    rss-rule:enabled true ;
    dcterms:description "Materialises the vulnerable flow subtype implied by a satisfied control-weakness evaluation."@en .

rss-rule:CategoryAssignmentMaterialiser a rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    dcterms:description "Records CategoryAssignment individuals only after the corresponding satisfied evaluation and class entailment already exist."@en .

rss-rule:L3ReachabilityMethod a rss-crit:ExternalComputationMethod ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    dcterms:description "Deterministic directed graph traversal from L1/L2-classified entry points over vulnerable information-flow edges. Produces shortest witness paths and never category membership."@en .

rss-rule:L3ReachabilityMechanism a rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    dcterms:description "Python implementation of the declared L3 reachability method."@en .

rss-rule:CandidateSetProjectionMethod a rss-crit:ExternalComputationMethod ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    dcterms:description "Deterministic projection of materialised CandidateExaminationTarget assignments belonging to one Run."@en .

rss-rule:CandidateSetProjectionMechanism a rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    dcterms:description "Python implementation of candidate-set projection in the Run orchestrator."@en .

rss-rule:SelectionCoverageMeasure a rss-crit:CoverageMeasure ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    rss-crit:measureDefinition "Number of distinct candidate elements included in the declared Selection divided by the number of distinct eligible candidate elements." ;
    rss-crit:eligibilityScope "Materialised CandidateExaminationTarget assignments in one run-scoped CandidateSet." ;
    rss-crit:exclusionDeclaration "No implicit exclusions. Assessor exclusions remain visible as candidate elements not included in the Selection." .

rss-rule:SelectionCoverageMethod a rss-crit:ExternalComputationMethod ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    dcterms:description "Computes the declared selection-coverage ratio; returns notComputable for an empty candidate universe."@en .

rss-rule:SelectionCoverageMechanism a rss-res:Mechanism ;
    rss-crit:hasVersion rss-rule:phase2RuleVersion ;
    dcterms:description "Python implementation of the declared selection-coverage method."@en .

rss-rule:DLSafeRule a owl:Class .
rss-rule:implementationFile a owl:DatatypeProperty .
rss-rule:ruleIdentifier a owl:DatatypeProperty .
rss-rule:enabled a owl:DatatypeProperty .
